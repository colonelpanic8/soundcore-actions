<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.colonelpanic.soundcoreactions.tests">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application android:label="Soundcore Actions tests" android:appComponentFactory="com.colonelpanic.soundcorepatch.ComponentFactory">
        <service android:name="com.colonelpanic.soundcorepatch.EarbudService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <service android:name="com.colonelpanic.soundcorepatch.MessageReaderService"
            android:exported="false" android:label="Spoken messages"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:process=":message_reader">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity android:name="com.colonelpanic.soundcoretest.Fixtures$Screen" android:exported="false" />
        <activity android:name="com.colonelpanic.soundcoretest.Fixtures$Target" android:exported="false" android:taskAffinity="com.colonelpanic.soundcoreactions.tests.target" />
        <activity android:name="com.colonelpanic.soundcorepatch.SettingsActivity" android:exported="true"
            android:taskAffinity="com.colonelpanic.soundcoreactions.tests.actions" android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
    <instrumentation android:name="com.colonelpanic.soundcorepatch.RuntimeTests" android:targetPackage="com.colonelpanic.soundcoreactions.tests" />
</manifest>
